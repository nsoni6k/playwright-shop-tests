{
  "name": "playwright-shop-tests",
  "version": "1.0.0",
  "private": true,
  "description": "Playwright + TypeScript UI and API test framework for automationexercise.com",
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test --project=ui",
    "test:api": "playwright test --project=api",
    "test:hybrid": "playwright test --project=hybrid",
    "test:smoke": "playwright test --grep @smoke",
    "test:headed": "playwright test --project=ui --headed",
    "report": "playwright show-report",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@faker-js/faker": "^10.6.0",
    "@playwright/test": "^1.49.0",
    "@types/node": "^22.9.0",
    "dotenv": "^16.4.5",
    "eslint": "^9.15.0",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.15.0"
  }
}
